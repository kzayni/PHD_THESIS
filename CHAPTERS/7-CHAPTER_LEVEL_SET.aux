\@writefile{lof}{\contentsline {figure}{\numberline {4.5}{\ignorespaces Illustration of local interface reconstruction within simplicial elements based on the sign of the level-set function $\phi $. Red nodes denote positive values ($\phi >0$), whereas blue nodes denote negative values ($\phi <0$). The interface $\phi =0$ is reconstructed by linear interpolation along the intersected edges. In 2D, the negative subregion is either the full triangle, a quadrilateral, or a triangle. In 3D, the negative subregion is either the full tetrahedron, a truncated tetrahedron, a clipped polyhedron, or a smaller tetrahedral subregion. These clipped regions are used to evaluate the local ice area or volume contribution without requiring a full surface extraction.}}{74}{figure.caption.54}\protected@file@percent }
\newlabel{fig:LocalExtraction}{{4.5}{74}{Illustration of local interface reconstruction within simplicial elements based on the sign of the level-set function $\phi $. Red nodes denote positive values ($\phi >0$), whereas blue nodes denote negative values ($\phi <0$). The interface $\phi =0$ is reconstructed by linear interpolation along the intersected edges. In 2D, the negative subregion is either the full triangle, a quadrilateral, or a triangle. In 3D, the negative subregion is either the full tetrahedron, a truncated tetrahedron, a clipped polyhedron, or a smaller tetrahedral subregion. These clipped regions are used to evaluate the local ice area or volume contribution without requiring a full surface extraction}{figure.caption.54}{}}
\newlabel{fig:LocalExtraction@cref}{{[figure][5][4]4.5}{[1][74][]74}{}{}{}}
